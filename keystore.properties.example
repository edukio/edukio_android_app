# Copie este arquivo para keystore.properties e ajuste os valores.
# NÃO coloque senhas aqui. O VS Code irá solicitá-las ao gerar a release.
#
# No Windows, prefira usar barras / no caminho:
# storeFile=C:/Users/seu_usuario/chaves/edukio-release.jks

storeFile=C:/caminho/para/edukio-release.jks
keyAlias=seu_alias
