{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gradle: Compilar APK Debug",
      "type": "shell",
      "command": "./gradlew",
      "windows": {
        "command": ".\\gradlew.bat"
      },
      "args": [
        "assembleDebug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Gradle: Instalar Debug",
      "type": "shell",
      "command": "./gradlew",
      "windows": {
        "command": ".\\gradlew.bat"
      },
      "args": [
        "installDebug"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Abrir Edukio",
      "type": "shell",
      "command": "adb",
      "args": [
        "shell",
        "am",
        "start",
        "-n",
        "com.edukio.app/.MainActivity"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Compilar, instalar e abrir",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Gradle: Instalar Debug",
        "Android: Abrir Edukio"
      ],
      "problemMatcher": []
    },
